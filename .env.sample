BOT_TOKEN=sample_discord_token
DATABASE_HOST=db
DATABASE_NAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_SSL=disable
DATABASE_USER=postgres
METRICS_ADDR=:3003
ENVIRONMENT=development
TZ=Europe/Berlin
# Uncomment this, if you want Online/Offline feature (bot) and the experience job (web) enabled
# TIBIA_WORLD_API_BASE_URL=http://tibiadata:8080/v4
WEB_BASE_URL=http://localhost:8080
WEB_ADDR=:8080
WEB_METRICS_ADDR=:3005
# Comma-separated Discord user ids with full access to every guild in the web panel
WEB_ADMIN_DISCORD_IDS=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The community Discord invite behind every support link (empty hides them)
DISCORD_INVITE_LINK=https://discord.gg/b7Qq8V2XFR
# The web experience job reads the TibiaData highscores (needs TIBIA_WORLD_API_BASE_URL)
WEB_EXPERIENCE_JOB_ENABLED=true
WEB_EXPERIENCE_JOB_INTERVAL=15m
