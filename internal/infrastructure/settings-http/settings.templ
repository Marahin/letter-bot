package settingshttp

import (
	"time"

	"spot-assistant/internal/core/dto/guildconfig"
	"spot-assistant/internal/core/dto/role"
	"spot-assistant/internal/infrastructure/i18n"
	"spot-assistant/internal/infrastructure/web"
)

// Settings is the admin-only server configuration page.
templ Settings(baseURL string, guild guildconfig.Config, roles []*role.Role, world string, inviteURL string, nav web.Nav) {
	@web.Layout(i18n.T(ctx, "settings.page.title", guild.Name), i18n.T(ctx, "settings.page.description", guild.Name), baseURL, web.GuildPath(guild.GuildID, "/settings"), nav) {
		// Settings is form-heavy, so it keeps a readable centred column rather than
		// spanning the page's wide content area.
		<div class="mx-auto w-full max-w-3xl">
			<div>
				<h1 class="font-display text-4xl font-bold -tracking-[0.02em] text-zone-50">{ i18n.T(ctx, "settings.page.heading") }</h1>
				<p class="mt-2 max-w-2xl text-sm leading-relaxed text-zone-400">{ i18n.T(ctx, "settings.page.lede", guild.Name) }</p>
			</div>
			@ReinviteBot(inviteURL)
			@RefreshData(guild)
			@WorldSettings(guild, world)
			for _, kind := range guildconfig.RoleKinds {
				@RankSection(guild, roles, kind)
			}
		</div>
		<script src={ web.AssetURL("/assets/alpine.js") } defer></script>
	}
}

// ReinviteBot links to the Discord bot invite for this server, pre-selected and
// carrying the current permission bitfield. Re-inviting re-applies permissions
// the bot is missing; Discord keeps the bot in place.
templ ReinviteBot(inviteURL string) {
	<section class="mt-8">
		<div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-zone-800 bg-zone-900 shadow-glass p-4">
			<div>
				<h2 class="font-display text-lg font-bold text-zone-100">{ i18n.T(ctx, "settings.reinvite.heading") }</h2>
				<p class="mt-1 max-w-2xl text-sm leading-relaxed text-zone-400">{ i18n.T(ctx, "settings.reinvite.body") }</p>
			</div>
			<a
				href={ templ.SafeURL(inviteURL) }
				target="_blank"
				rel="noopener"
				class="shrink-0 rounded-md bg-signal px-4 py-1.5 text-sm font-semibold text-zone-950 transition hover:bg-signal-bright"
			>{ i18n.T(ctx, "settings.reinvite.action") }</a>
		</div>
	</section>
}

// RefreshData asks the bot to sync the server's channels and roles again. The web
// has no Discord gateway, so this is the admin's way to pick up a new role or
// channel before the bot notices the change itself.
templ RefreshData(guild guildconfig.Config) {
	<section class="mt-4">
		<div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-zone-800 bg-zone-900 shadow-glass p-4">
			<div>
				<h2 class="font-display text-lg font-bold text-zone-100">{ i18n.T(ctx, "settings.refresh.heading") }</h2>
				<p class="mt-1 max-w-2xl text-sm leading-relaxed text-zone-400">{ i18n.T(ctx, "settings.refresh.body") }</p>
				<p id="refresh-status" aria-live="polite" class="mt-1 text-sm text-zone-400"></p>
			</div>
			<button
				type="button"
				hx-post={ web.GuildPath(guild.GuildID, "/settings/refresh") }
				hx-target="#refresh-status"
				hx-swap="innerHTML"
				class="inline-flex shrink-0 items-center gap-2 rounded-md bg-signal px-4 py-1.5 text-sm font-semibold text-zone-950 transition hover:bg-signal-bright"
			>
				<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path></svg>
				{ refreshLabel(ctx) }
			</button>
		</div>
	</section>
}

// RefreshStatus confirms that the bot was asked to sync.
templ RefreshStatus() {
	<span class="text-emerald-400">{ i18n.T(ctx, "settings.refresh.requested") }</span>
}

// RefreshCooldown says when the next refresh is allowed.
templ RefreshCooldown(retryAfter time.Duration) {
	<span class="text-amber-400">{ i18n.T(ctx, "settings.refresh.cooldown", cooldownMinutes(retryAfter)) }</span>
}

// WorldSettings picks the Tibia world whose online players the summary shows. It
// replaces the /world-set command, which keeps working.
templ WorldSettings(guild guildconfig.Config, world string) {
	<section class="mt-12">
		<h2 class="font-display text-xl font-semibold text-zone-100">{ i18n.T(ctx, "settings.world.heading") }</h2>
		<p class="mt-1 max-w-2xl text-sm leading-relaxed text-zone-400">{ i18n.T(ctx, "settings.world.body") }</p>
		<form
			hx-post={ web.GuildPath(guild.GuildID, "/settings/world") }
			hx-target="#world-status"
			hx-swap="innerHTML"
			class="mt-4 flex flex-wrap items-end gap-3 rounded-lg border border-zone-800 bg-zone-900 shadow-glass p-4"
		>
			<div class="flex flex-col gap-1.5">
				// A sibling label, not a wrapper: a click on an option inside a <label>
				// re-opens the panel.
				<label for="world" class="text-[11px] font-semibold uppercase tracking-[0.12em] text-zone-400">{ i18n.T(ctx, "settings.form.world") }</label>
				@web.Combobox(web.ComboboxProps{
					ID:       "world",
					Name:     "world",
					Label:    i18n.T(ctx, "settings.form.world"),
					Options:  worldOptions(ctx, world),
					Selected: world,
					Class:    "min-w-56",
				})
			</div>
			<button class="rounded-md bg-signal px-4 py-1.5 text-sm font-semibold text-zone-950 transition hover:bg-signal-bright">{ i18n.T(ctx, "settings.form.save") }</button>
			<span id="world-status" aria-live="polite" class="text-sm text-zone-400"></span>
		</form>
	</section>
}

// WorldStatus confirms the saved world.
templ WorldStatus() {
	<span class="text-emerald-400">{ i18n.T(ctx, "settings.world.saved") }</span>
}

// WorldInvalidStatus refuses an empty or unknown world.
templ WorldInvalidStatus() {
	<span class="text-amber-400">{ i18n.T(ctx, "settings.world.invalid") }</span>
}

// RankSection is one rank list as a checkbox grid over the synced roles. The
// Empty line says what an empty list means, because it differs per kind:
// reserve falls open to everyone, overbook falls back to the @Postman role.
templ RankSection(guild guildconfig.Config, roles []*role.Role, kind guildconfig.RoleKind) {
	{{ c := copyFor(ctx, kind) }}
	<section id={ roleFieldID(kind) } class="mt-12">
		<h2 class="font-display text-xl font-semibold text-zone-100">{ c.Heading }</h2>
		<p class="mt-1 max-w-2xl text-sm leading-relaxed text-zone-400">{ c.Body } { i18n.T(ctx, "settings.sync.roles_hint", refreshLabel(ctx)) }</p>
		if len(roles) == 0 {
			<p class="mt-3 max-w-2xl text-sm leading-relaxed text-zone-300">{ c.Empty }</p>
			<p class="mt-4 text-sm text-zone-500">{ i18n.T(ctx, "settings.sync.no_roles", refreshLabel(ctx)) }</p>
		} else {
			<form
				hx-post={ web.GuildPath(guild.GuildID, "/settings/ranks/"+string(kind)) }
				hx-target={ "#" + roleFieldID(kind) + "-status" }
				hx-swap="innerHTML"
				class="mt-4 rounded-lg border border-zone-800 bg-zone-900 shadow-glass p-4"
			>
				<p class="mb-3 flex items-start gap-2 text-sm leading-relaxed text-zone-300">
					<svg class="mt-0.5 h-4 w-4 shrink-0 text-signal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5"></path><path d="M12 8h.01"></path></svg>
					<span>{ c.Empty }</span>
				</p>
				<div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
					for _, r := range roles {
						<label class="flex items-center gap-2.5 rounded-md border border-zone-700 bg-zone-850 px-3 py-3 text-sm text-zone-300">
							<input type="checkbox" name="role_ids" value={ r.ID } checked?={ contains(guild.RoleIDs(kind), r.ID) } class="h-4 w-4 rounded border border-zone-600 bg-zone-850 accent-signal focus-visible:ring-2 focus-visible:ring-signal/30"/>
							if r.Color != 0 {
								<span class="h-2.5 w-2.5 shrink-0 rounded-full" style={ roleColorStyle(r.Color) } aria-hidden="true"></span>
							}
							{ r.Name }
						</label>
					}
				</div>
				<div class="mt-4 flex items-center gap-3">
					<button class="rounded-md bg-signal px-4 py-1.5 text-sm font-semibold text-zone-950 transition hover:bg-signal-bright">{ i18n.T(ctx, "settings.ranks.save") }</button>
					<span id={ roleFieldID(kind) + "-status" } aria-live="polite" class="text-sm text-zone-400"></span>
				</div>
			</form>
		}
	</section>
}

// RanksStatus confirms a saved rank list.
templ RanksStatus(kind guildconfig.RoleKind) {
	<span class="text-emerald-400">{ copyFor(ctx, kind).Saved }</span>
}

// StaleStatus answers a pick of a role or channel that is no longer synced.
templ StaleStatus() {
	<span class="text-amber-400">{ i18n.T(ctx, "settings.stale") }</span>
}
