package web

import "spot-assistant/internal/infrastructure/i18n"

// Landing is the home page. The Loot Calculator, the most used feature, opens
// ready to use at the top; the Letter bot's features and CTAs follow. It renders
// inside the marketing shell (top bar, no sidebar) for both anonymous and
// signed-in visitors. tool is the embedded calculator, nil for a link instead.
templ Landing(baseURL, inviteURL string, nav Nav, tool templ.Component) {
	@Layout(i18n.T(ctx, "landing.meta.title"), i18n.T(ctx, "landing.meta.description"), baseURL, "/", nav) {
		@landingCalculator(tool)
		@landingFeaturesSection(inviteURL, landingFeatures(ctx))
		@landingBottomCTA(inviteURL)
	}
}

// landingCalculator is the hero: a short headline over the working calculator.
templ landingCalculator(tool templ.Component) {
	<section aria-labelledby="landing-calculator-heading" class="mx-auto max-w-6xl px-6 pb-16 pt-8 sm:pt-10">
		<div class="mb-6 flex flex-col gap-2">
			<span class="flex flex-wrap items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-zone-300">
				{ i18n.T(ctx, "landing.calculator.eyebrow") }
				@noLoginBadge()
			</span>
			<h1 id="landing-calculator-heading" class="font-display text-3xl font-bold leading-tight -tracking-[0.03em] text-zone-50 sm:text-4xl">{ i18n.T(ctx, "landing.calculator.heading") }</h1>
			<p class="max-w-2xl text-[15px] leading-relaxed text-zone-300">{ i18n.T(ctx, "landing.calculator.sub") }</p>
		</div>
		if tool != nil {
			@tool
		} else {
			<a href={ templ.SafeURL(lootCalculatorPath) } class="group flex items-center gap-4 rounded-xl border border-zone-800 bg-zone-900 p-5 transition hover:border-signal/50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signal/60">
				<div class="grid h-11 w-11 shrink-0 place-items-center rounded-lg border border-signal/25 bg-signal/10 text-signal-bright">
					@toolGlyph("calculator", "h-5 w-5")
				</div>
				<span class="flex items-center gap-1.5 text-[15px] font-semibold text-signal-bright">{ i18n.T(ctx, "landing.cta.open_loot") } <span aria-hidden="true">→</span></span>
			</a>
		}
	</section>
}

// landingFeaturesSection introduces the Letter bot: headline, the invite and
// sign-in CTAs, and the six-card feature grid.
templ landingFeaturesSection(inviteURL string, features []serverFeature) {
	<section id="features" class="scroll-mt-20 border-t border-zone-800 bg-zone-900/40">
		<div class="mx-auto max-w-[1440px] px-6 pb-10 pt-16 sm:px-8">
			<div class="mb-11 text-center">
				<div class="mb-3.5 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-zone-300">{ i18n.T(ctx, "landing.features.eyebrow") }</div>
				<h2 class="mx-auto max-w-3xl font-display text-3xl font-bold leading-[1.1] -tracking-[0.02em] text-zone-50 sm:text-4xl">
					{ i18n.T(ctx, "landing.features.line1") }<br/>
					{ i18n.T(ctx, "landing.features.line2") }
				</h2>
				<p class="mx-auto mt-4 max-w-xl text-zone-300">{ i18n.T(ctx, "landing.features.sub") }</p>
				<div class="mt-8 flex flex-wrap justify-center gap-3.5">
					<a href={ templ.SafeURL(inviteURL) } class="flex min-h-11 items-center gap-2.5 rounded-lg bg-signal px-6 py-3 text-[15px] font-semibold text-zone-950 shadow-accent transition hover:bg-signal-bright focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signal/60 focus-visible:ring-offset-2 focus-visible:ring-offset-zone-950">
						@discordGlyph()
						{ i18n.T(ctx, "landing.cta.add_bot") }
					</a>
					<a href="/login" class="flex min-h-11 items-center gap-2.5 rounded-lg border border-signal/40 px-6 py-3 text-[15px] font-semibold text-signal-bright transition hover:border-signal hover:bg-signal/[0.08] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-signal/60">
						{ i18n.T(ctx, "landing.cta.log_in") }
					</a>
				</div>
			</div>
			<div class="grid gap-4 md:grid-cols-3">
				for _, f := range features {
					<div class="rounded-xl border border-zone-800 bg-zone-900 p-6">
						<div class="mb-3.5 grid h-9 w-9 place-items-center rounded-lg border border-zone-700 bg-zone-850 text-zone-300">
							@featureGlyph(f.Icon)
						</div>
						<h3 class="font-display text-[17px] font-bold text-zone-50">{ f.Name }</h3>
						<p class="mt-1.5 text-[13.5px] leading-relaxed text-zone-300">{ f.Desc }</p>
					</div>
				}
			</div>
		</div>
	</section>
}

// featureGlyph draws one feature's own mark.
templ featureGlyph(icon string) {
	switch icon {
		case "reservations":
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18M8 15h3"></path></svg>
		case "bot":
			@discordGlyph()
		case "stats":
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"></path><path d="M18 17V9M13 17V5M8 17v-3"></path></svg>
		case "channels":
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"></path></svg>
		case "characters":
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 20v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20"></path><circle cx="9" cy="6.5" r="3.5"></circle><path d="M22 20v-1.5a4 4 0 0 0-3-3.87M16.5 3.3a3.5 3.5 0 0 1 0 6.4"></path></svg>
		default:
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="15" r="4"></circle><path d="M10.8 12.2 20 3M17 6l2.5 2.5M14 9l2.5 2.5"></path></svg>
	}
}

// landingBottomCTA is the gradient closing call to action.
templ landingBottomCTA(inviteURL string) {
	<section class="mx-auto max-w-[1440px] px-6 pb-20 pt-16 sm:px-8">
		<div class="rounded-2xl border border-signal/30 bg-[linear-gradient(135deg,rgba(249,115,22,0.12),rgba(249,115,22,0.03))] px-10 py-14 text-center">
			<h2 class="font-display text-3xl font-bold -tracking-[0.02em] text-zone-50 sm:text-4xl">{ i18n.T(ctx, "landing.bottom.heading") }</h2>
			<p class="mx-auto mt-4 max-w-lg text-zone-300">{ i18n.T(ctx, "landing.bottom.sub") }</p>
			<div class="mt-8 flex flex-wrap justify-center gap-3.5">
				<a href={ templ.SafeURL(inviteURL) } class="flex items-center gap-2.5 rounded-lg bg-signal px-7 py-3.5 text-[15px] font-semibold text-zone-950 shadow-accent transition hover:bg-signal-bright">
					@discordGlyph()
					{ i18n.T(ctx, "landing.cta.add_bot") }
				</a>
				<a href="/login" class="flex items-center gap-2.5 rounded-lg border border-signal/40 px-7 py-3.5 text-[15px] font-semibold text-signal-bright transition hover:border-signal hover:bg-signal/[0.08]">
					{ i18n.T(ctx, "landing.cta.log_in") }
				</a>
			</div>
			<p class="mx-auto mt-7 max-w-lg text-sm text-zone-400">{ i18n.T(ctx, "landing.bottom.premium_note") }</p>
		</div>
	</section>
}

// noLoginBadge is the small "NO LOGIN" pill beside the public calculator.
templ noLoginBadge() {
	<span class="rounded border border-signal/30 bg-signal/10 px-1.5 py-0.5 text-signal-bright font-mono text-[10px] font-bold uppercase tracking-wider">{ i18n.T(ctx, "landing.badge.no_login") }</span>
}
