package web

import "spot-assistant/internal/infrastructure/i18n"

// Landing is the marketing home page: hero, the server feature grid, the no-login
// tool cards and a closing CTA. It renders inside the marketing shell (top bar, no
// sidebar) for both anonymous and signed-in visitors.
templ Landing(baseURL, inviteURL string, nav Nav) {
	@Layout(i18n.T(ctx, "landing.meta.title"), i18n.T(ctx, "landing.meta.description"), baseURL, "/", nav) {
		@landingHero(inviteURL)
		@landingFeaturesSection(landingFeatures(ctx))
		@landingToolsSection(landingTools(ctx))
		@landingBottomCTA(inviteURL)
	}
}

// landingHero is the top hero: headline, sub-copy and the two primary CTAs.
templ landingHero(inviteURL string) {
	<section class="mx-auto max-w-[1440px] px-6 pb-16 pt-20 text-center sm:px-8">
		<h1 class="mx-auto max-w-4xl font-display text-4xl font-bold leading-[1.05] -tracking-[0.03em] text-zone-50 sm:text-5xl md:text-6xl">
			{ i18n.T(ctx, "landing.hero.line1") }<br/>
			{ i18n.T(ctx, "landing.hero.line2") }
		</h1>
		<p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-zone-300">
			{ i18n.T(ctx, "landing.hero.sub") }
		</p>
		<div class="mt-9 flex flex-wrap justify-center gap-3.5">
			<a href={ templ.SafeURL(inviteURL) } class="flex items-center gap-2.5 rounded-lg bg-signal px-6 py-3.5 text-[15px] font-semibold text-zone-950 shadow-accent transition hover:bg-signal-bright">
				@discordGlyph()
				{ i18n.T(ctx, "landing.cta.add_bot") }
			</a>
			<a href="/login" class="flex items-center gap-2.5 rounded-lg border border-signal/40 px-6 py-3.5 text-[15px] font-semibold text-signal-bright transition hover:border-signal hover:bg-signal/[0.08]">
				{ i18n.T(ctx, "landing.cta.log_in") }
			</a>
		</div>
	</section>
}

// landingFeaturesSection is the six-card feature grid.
templ landingFeaturesSection(features []serverFeature) {
	<section id="features" class="mx-auto max-w-[1440px] scroll-mt-20 px-6 pb-10 pt-6 sm:px-8">
		<div class="mb-11 text-center">
			<div class="mb-3.5 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-zone-400">{ i18n.T(ctx, "landing.features.eyebrow") }</div>
			<h2 class="font-display text-3xl font-bold -tracking-[0.02em] text-zone-50 sm:text-4xl">{ i18n.T(ctx, "landing.features.heading") }</h2>
			<p class="mx-auto mt-3.5 max-w-xl text-zone-300">{ i18n.T(ctx, "landing.features.sub") }</p>
		</div>
		<div class="grid gap-4 md:grid-cols-3">
			for _, f := range features {
				<div class="rounded-xl border border-zone-800 bg-zone-900 p-6">
					<div class="mb-3.5 grid h-9 w-9 place-items-center rounded-lg border border-zone-700 bg-zone-850 text-zone-300">
						@featureGlyph(f.Icon)
					</div>
					<h3 class="font-display text-[17px] font-bold text-zone-50">{ f.Name }</h3>
					<p class="mt-1.5 text-[13.5px] leading-relaxed text-zone-300">{ f.Desc }</p>
				</div>
			}
		</div>
	</section>
}

// featureGlyph draws one feature's own mark.
templ featureGlyph(icon string) {
	switch icon {
		case "reservations":
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18M8 15h3"></path></svg>
		case "bot":
			@discordGlyph()
		case "stats":
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"></path><path d="M18 17V9M13 17V5M8 17v-3"></path></svg>
		case "channels":
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"></path></svg>
		case "characters":
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 20v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V20"></path><circle cx="9" cy="6.5" r="3.5"></circle><path d="M22 20v-1.5a4 4 0 0 0-3-3.87M16.5 3.3a3.5 3.5 0 0 1 0 6.4"></path></svg>
		default:
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="15" r="4"></circle><path d="M10.8 12.2 20 3M17 6l2.5 2.5M14 9l2.5 2.5"></path></svg>
	}
}

// landingToolsSection is the no-login tool cards.
templ landingToolsSection(tools []toolCard) {
	<section id="tools" class="mx-auto max-w-[1440px] px-6 pb-6 pt-10 sm:px-8">
		<div class="mb-11 text-center">
			<div class="mb-3.5 font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-zone-400">{ i18n.T(ctx, "landing.tools.eyebrow") }</div>
			<h2 class="font-display text-3xl font-bold -tracking-[0.02em] text-zone-50 sm:text-4xl">{ i18n.T(ctx, "landing.tools.heading") }</h2>
			<p class="mx-auto mt-3.5 max-w-xl text-zone-300">{ i18n.T(ctx, "landing.tools.sub") }</p>
		</div>
		<div class="mx-auto grid max-w-md gap-5">
			for _, t := range tools {
				@toolCardView(t)
			}
		</div>
	</section>
}

// toolCardView is one no-login tool card.
templ toolCardView(t toolCard) {
	<a href={ templ.SafeURL(t.Href) } class="group flex items-center gap-4 rounded-xl border border-zone-800 bg-zone-900 p-5 transition hover:border-signal/50">
		<div class="grid h-11 w-11 shrink-0 place-items-center rounded-lg border border-signal/25 bg-signal/10 text-signal-bright">
			@toolGlyph(t.Icon, "h-5 w-5")
		</div>
		<div class="min-w-0 flex-1">
			<h3 class="font-display text-[17px] font-bold text-zone-50">{ t.Name }</h3>
			<div class="mt-1 flex items-center gap-1.5 text-[13px] font-semibold text-signal-bright">{ t.CTA } <span aria-hidden="true">→</span></div>
		</div>
	</a>
}

// landingBottomCTA is the gradient closing call to action.
templ landingBottomCTA(inviteURL string) {
	<section class="mx-auto max-w-[1440px] px-6 pb-20 pt-16 sm:px-8">
		<div class="rounded-2xl border border-signal/30 bg-[linear-gradient(135deg,rgba(249,115,22,0.12),rgba(249,115,22,0.03))] px-10 py-14 text-center">
			<h2 class="font-display text-3xl font-bold -tracking-[0.02em] text-zone-50 sm:text-4xl">{ i18n.T(ctx, "landing.bottom.heading") }</h2>
			<p class="mx-auto mt-4 max-w-lg text-zone-300">{ i18n.T(ctx, "landing.bottom.sub") }</p>
			<div class="mt-8 flex flex-wrap justify-center gap-3.5">
				<a href={ templ.SafeURL(inviteURL) } class="flex items-center gap-2.5 rounded-lg bg-signal px-7 py-3.5 text-[15px] font-semibold text-zone-950 shadow-accent transition hover:bg-signal-bright">
					@discordGlyph()
					{ i18n.T(ctx, "landing.cta.add_bot") }
				</a>
				<a href={ templ.SafeURL(lootCalculatorPath) } class="flex items-center gap-2.5 rounded-lg border border-signal/40 px-7 py-3.5 text-[15px] font-semibold text-signal-bright transition hover:border-signal hover:bg-signal/[0.08]">
					{ i18n.T(ctx, "landing.cta.open_loot") }
					@noLoginBadge()
				</a>
			</div>
			<p class="mx-auto mt-7 max-w-lg text-sm text-zone-400">{ i18n.T(ctx, "landing.bottom.premium_note") }</p>
		</div>
	</section>
}

// noLoginBadge is the small "NO LOGIN" pill on the public tool CTAs.
templ noLoginBadge() {
	<span class="rounded bg-zone-950/25 px-1.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider">{ i18n.T(ctx, "landing.badge.no_login") }</span>
}
